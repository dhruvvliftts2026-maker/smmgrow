          <div className={`w-full max-w-sm rounded-3xl border p-5 space-y-3 ${cardCls}`}>
            <div className="flex items-center justify-between">
              <h3 className="font-bold text-base">Account ({account.buyerId})</h3>
              <button onClick={() => setLoginModalOpen(false)}>
                <X className="w-4 h-4" />
              </button>
            </div>

            {account.hasPassword ? (
              <div className="space-y-2 text-xs">
                <div className="flex items-center gap-2 text-emerald-400 font-semibold">
                  <CheckCircle2 className="w-4 h-4" /> Account saved in browser
                </div>
                {account.email && (
                  <p className={`flex items-center gap-1.5 ${muted}`}>
                    <Mail className="w-3.5 h-3.5" /> {account.email}
                  </p>
                )}
              </div>
            ) : (
              <form onSubmit={handleSaveAccountCredentials} className="space-y-3">
                <p className={`text-xs ${muted}`}>
                  Set a password and optional email to save your {account.buyerId} orders.
                </p>
                <input
                  type="password"
                  required
                  placeholder="Create password"
                  value={accPasswordInput}
                  onChange={(e) => setAccPasswordInput(e.target.value)}
                  className="w-full rounded-xl border border-[#7b2cbf]/50 bg-[#090512]/70 px-3 py-2.5 text-xs outline-none focus:border-[#ff2a85]"
                />
                <input
                  type="email"
                  placeholder="Email (optional)"
                  value={accEmailInput}
                  onChange={(e) => setAccEmailInput(e.target.value)}
                  className="w-full rounded-xl border border-[#7b2cbf]/50 bg-[#090512]/70 px-3 py-2.5 text-xs outline-none focus:border-[#ff2a85]"
                />
                {accSavedMsg && <p className="text-xs text-emerald-400">{accSavedMsg}</p>}
                <button
                  type="submit"
                  className="w-full py-2.5 rounded-xl font-bold text-xs text-white bg-gradient-to-r from-[#b026ff] to-[#ff2a85]"
                >
                  Save Account
                </button>
              </form>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
