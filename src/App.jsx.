function getEstimatedDelivery(service, pkgIndex) {
  if (service.id === "instagram_reels" && pkgIndex === 0) {
    return "~56 minutes delivery";
  }
  const mins = service.etaBaseMins + pkgIndex * 18;
  if (mins >= 120) {
    return `~${(mins / 60).toFixed(1)} hours delivery`;
  }
  return `~${mins} minutes delivery`;
}

function generateBuyerId() {
  return `buyer${Math.floor(100000 + Math.random() * 900000)}`;
}

